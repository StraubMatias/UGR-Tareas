TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu_token_de_turso
SESSION_SECRET=una_clave_larga_y_aleatoria

# Usuario administrador del portal. Se lee del entorno y nunca va hardcodeado
# en el código: al correr `npm run migrate` este usuario queda con rol 'admin',
# y `npm run admin:reset-password` regenera su contraseña con una aleatoria larga.
ADMIN_USUARIO=

# Opcionales: credenciales del campus virtual para el sincronizador (ugr-sync/).
# En local van en .env.local. En Vercel se cargan como Environment Variables
# (Project Settings → Environment Variables), igual que TURSO_*. Nunca se comparten.
UGRVIRTUAL_USER=
UGRVIRTUAL_PASSWORD=
